<script>
  // INTRO: full-screen curtain reveal, once per page load
  const introOverlay = document.getElementById('introOverlay');
  if (introOverlay) {
    document.body.style.overflow = 'hidden';
    window.addEventListener('load', () => {
      setTimeout(() => {
        introOverlay.classList.add('run');
        setTimeout(() => {
          introOverlay.classList.add('done');
          document.body.style.overflow = '';
        }, 1750);
      }, 350);
    });
  }

  // SCROLL REVEAL
  const revealEls = document.querySelectorAll('.reveal');
  revealEls.forEach(el =>
    new IntersectionObserver((entries) => {
      entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in-view'); } });
    }, { threshold: 0.12 }).observe(el)
  );

  // RAIL FILL + NODE ACTIVATION for a given track SVG
  function initTrack(opts) {
    const {
      svg,
      railFillL,
      railFillR,
      totalHeight,
      nodes,
      dots,
      sleepers,
      entries,
      activeColor,
      dotActive,
    } = opts;

    const ACTIVE_STROKE = activeColor || '#4fae85';
    const DOT_ACTIVE    = dotActive   || '#4fae85';

    function update() {
      if (!svg) return;
      const rect = svg.getBoundingClientRect();
      const progress = (window.innerHeight * 0.55 - rect.top) / rect.height;
      const clamped  = Math.max(0, Math.min(1, progress));
      const fillH    = clamped * totalHeight;

      railFillL.setAttribute('height', fillH);
      railFillR.setAttribute('height', fillH);

      nodes.forEach((node, i) => {
        const nodeY = parseFloat(node.getAttribute('cy'));
        const active = fillH >= nodeY;
        if (active) {
          node.setAttribute('stroke', ACTIVE_STROKE);
          dots[i].setAttribute('fill', DOT_ACTIVE);
          if (sleepers[i]) sleepers[i].style.opacity = '1';
          if (entries[i])  entries[i].classList.add('active');
        } else {
          node.setAttribute('stroke', '#515C62');
          dots[i].setAttribute('fill', '#515C62');
          if (sleepers[i]) sleepers[i].style.opacity = null;
          if (entries[i])  entries[i].classList.remove('active');
        }
      });
    }

    window.addEventListener('scroll',  () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize',  () => requestAnimationFrame(update));
    update();
  }

  // EXPERIENCE TRACK
  const expSvg = document.querySelector('#experience .track-svg');
  if (expSvg) {
    initTrack({
      svg:         expSvg,
      railFillL:   expSvg.querySelector('.rail-fill-left'),
      railFillR:   expSvg.querySelector('.rail-fill-right'),
      totalHeight: 800,
      nodes:       expSvg.querySelectorAll('.signal-node'),
      dots:        expSvg.querySelectorAll('.signal-dot'),
      sleepers:    expSvg.querySelectorAll('.entry-sleeper'),
      entries:     document.querySelectorAll('#experience .rw-entry'),
      activeColor: '#4fae85',
      dotActive:   '#4fae85',
    });
  }

  // EDUCATION TRACK
  const eduSvg = document.querySelector('#education .track-svg');
  if (eduSvg) {
    initTrack({
      svg:         eduSvg,
      railFillL:   eduSvg.querySelector('.rail-fill-left-edu'),
      railFillR:   eduSvg.querySelector('.rail-fill-right-edu'),
      totalHeight: 800,
      nodes:       eduSvg.querySelectorAll('.signal-node-edu'),
      dots:        eduSvg.querySelectorAll('.signal-dot-edu'),
      sleepers:    eduSvg.querySelectorAll('.entry-sleeper-edu'),
      entries:     document.querySelectorAll('#education .rw-entry'),
      activeColor: '#6fa3de',
      dotActive:   '#6fa3de',
    });
  }

  // CAROUSELS — one reusable function drives both About and Personal carousels
  function initCarousel(id) {
    const el = document.getElementById(id);
    if (!el) return;
    const slides = el.querySelectorAll('.carousel-slide');
    const dots = el.querySelectorAll('.dot');
    let current = 0;
    let timer;

    function goTo(index) {
      slides[current].classList.remove('active');
      dots[current].classList.remove('active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('active');
      dots[current].classList.add('active');
    }
    function nextSlide() { goTo(current + 1); }
    function startAuto() { timer = setInterval(nextSlide, 5000); }
    function stopAuto() { clearInterval(timer); }

    const prevBtn = el.querySelector('.prev');
    const nextBtn = el.querySelector('.next');
    if (prevBtn) prevBtn.addEventListener('click', () => { goTo(current - 1); stopAuto(); startAuto(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { goTo(current + 1); stopAuto(); startAuto(); });
    dots.forEach(dot => dot.addEventListener('click', () => { goTo(parseInt(dot.dataset.index)); stopAuto(); startAuto(); }));

    el.addEventListener('mouseenter', stopAuto);
    el.addEventListener('mouseleave', startAuto);
    startAuto();
  }

  initCarousel('aboutCarousel');
  initCarousel('personalCarousel');
</script>