<Layout title="Michele Capponi | Portfolio">
  <div class="intro-overlay" id="introOverlay" aria-hidden="true">
    <div class="intro-panel">
      <svg class="intro-train" viewBox="0 0 140 46" xmlns="http://www.w3.org/2000/svg">
        <rect x="10" y="14" width="70" height="20" rx="4" fill="currentColor"/>
        <rect x="70" y="4" width="26" height="30" rx="3" fill="currentColor"/>
        <rect x="76" y="9" width="14" height="10" rx="1.5" fill="var(--bg)"/>
        <rect x="20" y="6" width="7" height="10" rx="1.5" fill="currentColor"/>
        <circle cx="24" cy="36" r="6" fill="currentColor"/>
        <circle cx="46" cy="36" r="6" fill="currentColor"/>
        <circle cx="68" cy="36" r="6" fill="currentColor"/>
        <circle cx="90" cy="36" r="6" fill="currentColor"/>
        <rect x="20" y="33.5" width="74" height="3" rx="1.5" fill="currentColor" opacity="0.55"/>
        <!-- small red signal light, front of the train -->
        <circle cx="94" cy="14" r="3" fill="#c1443a"/>
      </svg>
    </div>
  </div>

  <div class="ambient" aria-hidden="true">
    <span class="blob blob-green"></span>
    <span class="blob blob-blue"></span>
  </div>

  <main>
    <!-- HERO -->
    <section class="hero reveal">
      <div class="hero-text">
        <p class="eyebrow">MSc · Artificial Intelligence &amp; Robotics</p>
        <h1>Michele Capponi</h1>
        <p class="tagline">
          Building the control loop between embedded systems and autonomous machines —
          with an eye on the railway industry.
        </p>
        <div class="links">
          <a href="https://github.com/kpnss" target="_blank" rel="noopener">GitHub</a>
          <a href="https://linkedin.com/in/michele-capponi" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:michelecapponiposta@gmail.com">Email</a>
          <a href="/cv-michele-capponi.pdf" download class="cv-button">Download CV</a>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-photo-ring"></div>
        <img class="hero-photo" src="public/profile.jpg" alt="Portrait of Michele Capponi" />
      </div>
      <div class="scroll-cue" aria-hidden="true" style="transform: translateY(-80px);"><span></span></div>
    </section>

    <!-- ABOUT -->
    <section class="section about reveal">
      <div class="about-photo" id="aboutCarousel">
        <div class="carousel-track">
          <img src="/cansat_1.JPG" alt="SASA satellite" class="carousel-slide active" />
          <img src="/cansat_2.JPG" alt="SASA satellite" class="carousel-slide" />
          <img src="/cansat_3.jpg" alt="SASA satellite" class="carousel-slide" />
          <img src="/cansat_4.jpg" alt="SASA satellite" class="carousel-slide" />
          <img src="/fc_1.jpg" alt="Fast Charge car" class="carousel-slide" />
        </div>
        <div class="carousel-dots">
          <span class="dot active" data-index="0"></span>
          <span class="dot" data-index="1"></span>
          <span class="dot" data-index="2"></span>
          <span class="dot" data-index="3"></span>
          <span class="dot" data-index="4"></span>
        </div>
      </div>
      <div class="about-text">
        <p class="section-eyebrow">About</p>
        <h2>Grounded in theory, built for the field</h2>
        <p>
          MSc student in Artificial Intelligence and Robotics at Sapienza University of Rome,
          combining a strong theoretical foundation with practical experience in embedded systems,
          control engineering, and autonomous robotics. My goal is to contribute to the railway
          industry, where I see the strongest intersection of safety, automation, and societal impact.
        </p>
      </div>
    </section>

